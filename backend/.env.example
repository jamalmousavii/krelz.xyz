# ============================================
# Krelz Network Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# ============================================

# --- Server ---
NODE_ENV=production
API_PORT=3000
WS_PORT=8444
BACKEND_URL=https://krelz.xyz

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://krelz:krelz_secure_password@localhost:5432/krelz

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Security ---
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- NowPayments (7 Cryptocurrencies) ---
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1

# --- Free Cloud AI Providers (at least one required for inference) ---
# Groq - Free tier: 30 RPM, 14,400 RPD (https://console.groq.com)
GROQ_API_KEY=

# OpenRouter - Free tier: 20 RPM, 50 RPD (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Cerebras - Free tier: ~1M tokens/day (https://cloud.cerebras.ai/)
CEREBRAS_API_KEY=

# Cloudflare Workers AI - Free tier: 10K neurons/day (https://dash.cloudflare.com/)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Sentry (Optional - Error Tracking) ---
SENTRY_DSN=

# --- Ollama (Local LLM) ---
OLLAMA_URL=http://localhost:11434

# ============================================
# Frontend (Next.js) - Copy to frontend/.env.local
# ============================================
# NEXT_PUBLIC_API_URL=https://krelz.xyz
# NEXT_PUBLIC_WS_URL=wss://krelz.xyz:8443/ws