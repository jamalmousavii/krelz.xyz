# Copy to /etc/krelz/backup.env (chmod 600) and adjust. Sourced by
# scripts/backup-db.sh and scripts/restore-db.sh.

# Container + database to dump (docker exec <container> pg_dump -U <user> -d <db>).
BACKUP_CONTAINER=krelz-postgres
BACKUP_DB_USER=krelz
BACKUP_DB_NAME=krelz

# Where encrypted dumps land on this host and how long they are kept.
BACKUP_DIR=/var/backups/krelz
BACKUP_RETENTION_DAYS=14

# Openssl passphrase file (first line = passphrase). REQUIRED for both backup
# and restore; store a copy in your password manager, or offsite backups are
# undecryptable if this host is lost.
# Generate: openssl rand -base64 32 > /etc/krelz/backup.pass && chmod 600 /etc/krelz/backup.pass
BACKUP_PASSPHRASE_FILE=/etc/krelz/backup.pass

# Optional offsite copy via rclone (Backblaze B2, S3, ...). Examples:
#   BACKUP_REMOTE=b2:krelz-backups
#   BACKUP_REMOTE=s3:my-bucket/krelz
# Leave empty to keep local-only backups.
BACKUP_REMOTE=
