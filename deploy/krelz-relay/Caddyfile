# Krelz relay — browser → this host (65.109.190.133, reachable from networks
# that filter the krelz.xyz SNI / block the origin IP) → Cloudflare → origin.
#
# Primary URL:  https://65-109-190-133.nip.io   (real LE cert, auto-renewed)
# Fallback:     https://65.109.190.133           (self-signed; click through)
# Plain http on :80 redirects to the primary URL.
#
# Run (ports 80/443 need root → Docker):
#   docker run -d --name krelz-relay --restart unless-stopped \
#     -p 80:80 -p 443:443 \
#     -v ./Caddyfile:/etc/caddy/Caddyfile:ro \
#     -v krelz-relay-data:/data -v krelz-relay-config:/config \
#     caddy:2-alpine

# nip.io hostname: real Let's Encrypt cert (HTTP-01 on :80), auto-renewed.
65-109-190-133.nip.io {
	reverse_proxy https://krelz.xyz {
		header_up Host krelz.xyz
		header_up X-Forwarded-Proto {scheme}
		transport http {
			tls_server_name krelz.xyz
		}
		# SSE / streaming chat must not be buffered.
		flush_interval -1
	}
}

# Raw-IP access (no SNI) and unknown hostnames: self-signed cert — the
# visitor clicks through the warning once. Same proxy.
:443 {
	reverse_proxy https://krelz.xyz {
		header_up Host krelz.xyz
		header_up X-Forwarded-Proto {scheme}
		transport http {
			tls_server_name krelz.xyz
		}
		flush_interval -1
	}
}

# Plain HTTP: ACME challenge is handled by Caddy for the nip.io site above;
# everything else (e.g. http://65.109.190.133/) goes to the real-cert URL.
:80 {
	@notAcme not path /.well-known/acme-challenge/*
	handle @notAcme {
		redir https://65-109-190-133.nip.io{uri} permanent
	}
}
