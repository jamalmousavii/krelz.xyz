[Unit]
Description=Krelz localhost.run SSH reverse tunnel (Iran v4 bypass)
After=network-online.target
Wants=network-online.target

[Service]
# Hardened in v3.45.0: dedicated unprivileged system user, pinned host key
# (no accept-new at runtime), no new privileges, strict filesystem view.
# Setup on the server (once):
#   useradd --system --create-home --home-dir /var/lib/krelz-tunnel \
#     --shell /usr/sbin/nologin krelz-tunnel
#   mkdir -p /var/lib/krelz-tunnel/.ssh && chmod 700 /var/lib/krelz-tunnel/.ssh
#   ssh-keyscan -t rsa,ecdsa,ed25519 localhost.run > /var/lib/krelz-tunnel/.ssh/known_hosts
#   chown -R krelz-tunnel:krelz-tunnel /var/lib/krelz-tunnel
# NOTE: no -N — localhost.run prints the assigned https://<random>.lhr.life
# URL only with a shell session. URL changes on every reconnect (free tier);
# nginx serves *.lhr.life so any subdomain works.
User=krelz-tunnel
Group=krelz-tunnel
Environment=HOME=/var/lib/krelz-tunnel
ExecStart=/usr/bin/ssh -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/var/lib/krelz-tunnel/.ssh/known_hosts -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -o ConnectTimeout=15 -R 80:127.0.0.1:80 nokey@localhost.run
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/krelz-tunnel

[Install]
WantedBy=multi-user.target
