# Build-time public Google OAuth client id.
# NEXT_PUBLIC_* values are inlined at BUILD time — if this file is missing on
# the server, the "Sign in with Google" button silently disappears (v3.29.1
# incident: .env.local was lost in a late-Sep deploy and the button vanished
# after Sep 23). Must match GOOGLE_CLIENT_ID in backend/.env.
# Copy to .env.local on the server: cp .env.example .env.local
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
